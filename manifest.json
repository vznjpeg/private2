{
  "manifest_version": 3,
  "name": "BirdTalk",
  "version": "1.0.0",
  "description": "Shows the most popular tweets from any given Twitter account in your browser sidebar",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://api.twitter.com/*",
    "https://twitter.com/*",
    "https://x.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/icon-16.png",
      "48": "images/icon-48.png",
      "128": "images/icon-128.png"
    }
  },
  "icons": {
    "16": "images/icon-16.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
